<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Pandre.Desktop"
             xmlns:vm="using:Pandre.Desktop.ViewModels"
             x:Class="Pandre.Desktop.Views.PanView"
             x:DataType="vm:PanViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <!-- 工具栏 -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,0,0,8">
      <Button Grid.Column="0" Classes="icon-btn" Command="{Binding UpCommand}" IsEnabled="{Binding CanGoUp}" Margin="0,0,8,0">
        <PathIcon Data="{x:Static local:AppIcons.FolderArrowUp}" Width="17" Height="17"/>
      </Button>
      <Button Grid.Column="1" Classes="icon-btn" Command="{Binding RefreshCommand}" Margin="0,0,8,0">
        <PathIcon Data="{x:Static local:AppIcons.ArrowSyncCircle}" Width="17" Height="17"/>
      </Button>
      <TextBox Grid.Column="2" Text="{Binding SearchText}" PlaceholderText="搜索当前网盘…" Margin="0,0,8,0"
               KeyDown="OnSearchKeyDown"/>
      <Button Grid.Column="3" Content="搜索" Command="{Binding SearchCommand}" Margin="0,0,8,0"/>
      <Button Grid.Column="4" Classes="primary" Content="下载选中" Command="{Binding DownloadSelectedCommand}"/>
    </Grid>
    <!-- P2 操作行 -->
    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
      <Button Margin="0,0,8,0" Click="OnUploadClick" ToolTip.Tip="上传本地文件到当前目录">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Data="{x:Static local:AppIcons.ArrowUpload}" Width="15" Height="15" VerticalAlignment="Center"/>
          <TextBlock Text="上传" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <Button Margin="0,0,8,0" Command="{Binding NewFolderCommand}" ToolTip.Tip="在当前目录新建文件夹">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Data="{x:Static local:AppIcons.FolderAdd}" Width="15" Height="15" VerticalAlignment="Center"/>
          <TextBlock Text="新建文件夹" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <Button Margin="0,0,8,0" Command="{Binding SaveShareCommand}" IsVisible="{Binding !IsBaidu}" ToolTip.Tip="转存外部分享链接到当前目录">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Data="{x:Static local:AppIcons.Add}" Width="15" Height="15" VerticalAlignment="Center"/>
          <TextBlock Text="转存" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <Button Margin="0,0,8,0" Command="{Binding OfflineDownloadCommand}" IsVisible="{Binding IsBaidu}" ToolTip.Tip="百度离线下载（magnet/ed2k）">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Data="{x:Static local:AppIcons.CloudArrowDown}" Width="15" Height="15" VerticalAlignment="Center"/>
          <TextBlock Text="离线下载" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <Button Margin="0,0,8,0" Command="{Binding ShareManageCommand}" ToolTip.Tip="管理我的分享（列表/复制/取消）">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Data="{x:Static local:AppIcons.Share}" Width="15" Height="15" VerticalAlignment="Center"/>
          <TextBlock Text="分享管理" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <Button Margin="0,0,8,0" Command="{Binding ShareSelectedCommand}" IsEnabled="{Binding HasSelection}" ToolTip.Tip="为选中项创建永久分享链接">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Data="{x:Static local:AppIcons.Share}" Width="15" Height="15" VerticalAlignment="Center"/>
          <TextBlock Text="分享" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <Button Margin="0,0,8,0" Command="{Binding RenameSelectedCommand}" IsEnabled="{Binding HasSingleSelection}" ToolTip.Tip="重命名选中项">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Data="{x:Static local:AppIcons.Edit}" Width="15" Height="15" VerticalAlignment="Center"/>
          <TextBlock Text="重命名" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <Button Command="{Binding DeleteSelectedCommand}" IsEnabled="{Binding HasSelection}" ToolTip.Tip="删除选中项（进回收站）">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Data="{x:Static local:AppIcons.Delete}" Width="15" Height="15" VerticalAlignment="Center"/>
          <TextBlock Text="删除" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </WrapPanel>
    <!-- 路径 + 状态 + 上传进度 -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <TextBlock Grid.Column="0" Classes="secondary" Text="{Binding PathText}" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Classes="secondary" VerticalAlignment="Center" Text="{Binding StatusMessage}"
                 IsVisible="{Binding !IsUploading}"/>
      <TextBlock Grid.Column="1" Classes="secondary" VerticalAlignment="Center" Text="{Binding UploadProgressText}"
                 IsVisible="{Binding IsUploading}"/>
    </Grid>
    <!-- 文件行列表（Ctrl/Shift 多选） -->
    <ListBox Grid.Row="3" Classes="rows" x:Name="FileList" ItemsSource="{Binding Files}"
             SelectionMode="Multiple" SelectedItems="{Binding SelectedFiles}"
             DoubleTapped="OnRowDoubleTapped">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:FileRowViewModel">
          <Grid>
            <Border Classes="sel-bar" Width="3" Height="22" HorizontalAlignment="Left"
                    VerticalAlignment="Center" Margin="4,0,0,0" ZIndex="1"/>
            <Border Classes="row-card">
            <Grid ColumnDefinitions="Auto,*,100,140" VerticalAlignment="Center">
              <Border Grid.Column="0" Width="34" Height="34" Margin="0,0,12,0" CornerRadius="6"
                      Background="{DynamicResource ThumbBgBrush}" ClipToBounds="True">
                <Panel>
                  <Image Source="{Binding Thumb}" Stretch="UniformToFill" IsVisible="{Binding !!Thumb}"/>
                  <PathIcon Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Foreground="{DynamicResource AccentBrush}"
                            IsVisible="{Binding !Thumb}"
                            Data="{Binding Icon}"/>
                </Panel>
              </Border>
              <TextBlock Grid.Column="1" Text="{Binding File.Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Column="2" Classes="tertiary" Text="{Binding SizeText}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="3" Classes="tertiary" Text="{Binding ModifiedText}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
            </Border>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
