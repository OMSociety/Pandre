<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Pandre.Desktop"
        xmlns:vm="using:Pandre.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="Pandre.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="盘多录 Pandre"
        Width="1100" Height="700"
        MinWidth="900" MinHeight="600"
        Icon="/Assets/pandre.ico"
        TransparencyLevelHint="Mica, AcrylicBlur"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40"
        WindowDecorations="BorderOnly">

  <Grid RowDefinitions="40,*" ColumnDefinitions="72,*">
    <!-- 窄侧栏：贯通整窗高度（含标题栏行），logo 与导航整体上移 -->
    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Background="{DynamicResource NavBgBrush}">
      <Grid RowDefinitions="Auto,*,Auto">
        <!-- 顶部 Logo：中心落在「窗口顶端 → 首条导航项顶端」的中点，导航项位置保持不变 -->
        <Border Grid.Row="0" Margin="0,14,0,4">
          <Viewbox Width="26" Height="26" HorizontalAlignment="Center">
            <Path Data="{x:Static local:AppIcons.PandreMark}"
                  Fill="{DynamicResource AccentBrush}"/>
          </Viewbox>
        </Border>
        <!-- 导航（共享指示条悬浮在上，位置由代码后置测量实际项坐标） -->
        <Grid Grid.Row="1" x:Name="NavArea" Margin="0,8,0,0">
          <ListBox x:Name="NavList" Classes="nav" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NavItem">
                <Border Classes="nav-item" Margin="0,1" MinHeight="52">
                  <StackPanel Orientation="Vertical" Spacing="2"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                    <PathIcon Width="20" Height="20" HorizontalAlignment="Center"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Data="{Binding CurrentIcon}"/>
                    <TextBlock Text="{Binding Title}" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <!-- 共享果冻指示条：代码后置实测定位，竖直居中由布局负责 -->
          <Border x:Name="NavIndicator" Width="3" Height="20" CornerRadius="2"
                  IsHitTestVisible="False" IsVisible="False"
                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"
                  Background="{DynamicResource AccentBrush}"/>
        </Grid>
      </Grid>
    </Border>

    <!-- 标题栏拖拽区（仅内容列） -->
    <Border Grid.Row="0" Grid.Column="1" Background="Transparent" x:Name="TitleDragArea"
            PointerPressed="OnTitleBarPointerPressed"/>

    <!-- 窗口按钮自绘：装饰层 WindowDecorations=BorderOnly 只画边框与缩放 -->
    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                HorizontalAlignment="Right" VerticalAlignment="Stretch">
      <Button Classes="caption" Click="OnMinimizeClick" ToolTip.Tip="最小化">
        <Rectangle Width="10" Height="1" Fill="{DynamicResource TextPrimaryBrush}"/>
      </Button>
      <Button Classes="caption" Click="OnMaximizeClick" ToolTip.Tip="最大化 / 还原">
        <Grid Width="10" Height="10">
          <Rectangle x:Name="MaxIcon" Width="10" Height="10" StrokeThickness="1"
                     Stroke="{DynamicResource TextPrimaryBrush}" Fill="Transparent"/>
          <Grid x:Name="RestoreIcon" Width="10" Height="10" IsVisible="False">
            <Rectangle Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                       StrokeThickness="1" Stroke="{DynamicResource TextPrimaryBrush}" Fill="Transparent"/>
            <Rectangle Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                       StrokeThickness="1" Stroke="{DynamicResource TextPrimaryBrush}"
                       Fill="{DynamicResource NavBgBrush}"/>
          </Grid>
        </Grid>
      </Button>
      <Button Classes="caption caption-close" Click="OnCloseClick" ToolTip.Tip="关闭">
        <PathIcon Data="{x:Static local:AppIcons.Dismiss}" Width="12" Height="12"/>
      </Button>
    </StackPanel>

    <!-- 内容区 -->
    <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="20,12,20,16">
          <!-- 页头：右侧为当前网盘的登录按钮（非网盘页无按钮） -->
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Grid.Column="0" Classes="title" Text="{Binding SelectedNav.Title}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Command="{Binding OpenLoginPanelCommand}"
                    IsVisible="{Binding LoginCard, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Padding="12,5" VerticalAlignment="Center" ToolTip.Tip="扫码登录 / 查看账号">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{Binding LoginCard.Icon}" Width="14" Height="14"/>
                <TextBlock Text="{Binding LoginCard.ButtonText}" FontSize="12"/>
              </StackPanel>
            </Button>
          </Grid>
          <!-- 页面（带切换动效） -->
          <TransitioningContentControl Grid.Row="1" Content="{Binding CurrentPage}"
                                       IsTransitionReversed="{Binding IsNavBack}">
            <TransitioningContentControl.PageTransition>
              <!-- 浮起进场：旧页 150ms 淡出，新页从下方 20px 淡入上浮（后退时从上方落下） -->
              <local:ConnectedFadeTransition />
            </TransitioningContentControl.PageTransition>
          </TransitioningContentControl>

          <!-- 启动初始化失败提示（可见化：只写调试输出用户看不到） -->
          <TextBlock Grid.Row="2" Classes="tertiary" FontSize="11" Margin="0,8,0,0"
                     IsVisible="{Binding InitError, Converter={x:Static ObjectConverters.IsNotNull}}"
                     Text="{Binding InitError}" TextWrapping="Wrap"/>
        </Grid>

    <!-- 网盘操作伪弹窗（新建/重命名/删除确认/分享/转存/离线/分享管理）：挂窗口级，遮罩盖住侧栏与标题栏。
         可见性绑 MainViewModel.IsPanDialogOpen（null 安全）；DataContext 下放到卡片层。 -->
    <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2" ZIndex="30"
          IsVisible="{Binding IsPanDialogOpen}">
      <Border Background="{DynamicResource ScrimBrush}" PointerPressed="OnPanDialogScrimPressed"/>
      <Border Classes="dialog" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20"
              DataContext="{Binding CurrentPan}" x:DataType="vm:PanViewModel">
        <StackPanel Spacing="14">
          <TextBlock Text="{Binding DialogTitle}" FontSize="16" FontWeight="SemiBold"/>
          <TextBox Text="{Binding DialogInput}" PlaceholderText="{Binding DialogInputWatermark}"
                   IsVisible="{Binding DialogHasInput}"/>
          <TextBox Text="{Binding DialogInput2}" PlaceholderText="{Binding DialogInput2Watermark}"
                   IsVisible="{Binding DialogHasInput2}"/>
          <TextBlock Text="{Binding DialogText}" IsVisible="{Binding DialogShowText}"
                     TextWrapping="Wrap" Classes="secondary" MaxWidth="400"/>
          <!-- 分享管理列表 -->
          <ScrollViewer MaxHeight="320" IsVisible="{Binding DialogIsShares}">
            <ItemsControl ItemsSource="{Binding DialogShares}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ShareRowViewModel">
                  <Border Classes="row-card" Margin="0,3" Padding="10,8">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"/>
                        <TextBlock Text="{Binding UrlText}" Classes="secondary" FontSize="11"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding UrlText}"/>
                        <TextBlock Text="{Binding TimeText}" Classes="tertiary" FontSize="11"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                  VerticalAlignment="Center">
                        <Button Content="复制" Click="OnCopyShareLinkClick" ToolTip.Tip="复制分享链接"/>
                        <Button Content="{Binding CancelText}" Command="{Binding CancelShareCommand}"
                                ToolTip.Tip="取消这条分享（点两次确认）"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="复制" IsVisible="{Binding DialogHasText}" Click="OnCopyPanDialogTextClick"/>
            <Button Content="取消" Command="{Binding DialogCancelCommand}"/>
            <Button Classes="primary" Content="确定" Command="{Binding DialogConfirmCommand}"
                    IsVisible="{Binding DialogHasConfirm}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- 功能开关伪弹窗：独立一页的开关清单（返回箭头 + 复选行） -->
    <Grid x:Name="FeatureOverlay" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
          Background="{DynamicResource ScrimBrush}"
          IsVisible="{Binding IsFeaturePanelOpen}"
          PointerPressed="OnFeatureOverlayPressed">
      <Border Classes="dialog" Width="420" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center"
              Padding="20" DataContext="{Binding FeaturePanel}" x:DataType="vm:FeaturePanelViewModel">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
            <Button Grid.Column="0" Classes="icon-btn" Click="OnCloseFeaturePanelClick" ToolTip.Tip="返回">
              <PathIcon Data="{x:Static local:AppIcons.ArrowLeft}" Width="16" Height="16"/>
            </Button>
            <TextBlock Grid.Column="1" Classes="card-title" Margin="9,0,0,0" VerticalAlignment="Center"
                       Text="功能开关"/>
          </Grid>

          <ScrollViewer Grid.Row="1" Margin="0,14,0,0">
            <ItemsControl ItemsSource="{Binding Toggles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FeatureToggleViewModel">
                  <CheckBox IsChecked="{Binding IsOn}" Margin="0,4" HorizontalContentAlignment="Left">
                    <StackPanel Margin="8,0,0,0">
                      <TextBlock Text="{Binding Title}"/>
                      <TextBlock Classes="tertiary" FontSize="11" TextWrapping="Wrap"
                                 Text="{Binding Description}"/>
                    </StackPanel>
                  </CheckBox>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <TextBlock Grid.Row="2" Classes="secondary" Margin="0,14,0,0" TextWrapping="Wrap"
                     Text="改动立即生效并保存。开关对百度网盘与夸克网盘同时起作用。"/>
        </Grid>
      </Border>
    </Grid>

    <!-- 登录伪弹窗：遮罩 + 抬升卡片（点遮罩空白处或 Esc 关闭） -->
    <Grid x:Name="LoginOverlay" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
          Background="{DynamicResource ScrimBrush}"
          IsVisible="{Binding IsLoginPanelOpen}"
          PointerPressed="OnOverlayPointerPressed">
      <Border Classes="dialog" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center"
              DataContext="{Binding LoginCard}" x:DataType="vm:LoginCardViewModel">
        <Grid RowDefinitions="Auto,Auto,Auto">
          <!-- 标题行 -->
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
            <PathIcon Grid.Column="0" Data="{Binding Icon}" Width="20" Height="20"
                      Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Classes="card-title" Margin="9,0,0,0" VerticalAlignment="Center"
                       Text="{Binding Title}"/>
            <Button Grid.Column="2" Classes="icon-btn" Click="OnCloseLoginPanelClick" ToolTip.Tip="关闭">
              <PathIcon Data="{x:Static local:AppIcons.Dismiss}" Width="11" Height="11"/>
            </Button>
          </Grid>

          <!-- 内容 -->
          <StackPanel Grid.Row="1" Spacing="12" Margin="0,14,0,0">
            <TextBlock Classes="secondary" Text="{Binding ScanHint}"
                       IsVisible="{Binding !IsLoggedIn}"/>
            <Border Classes="qr-frame" Width="216" Height="216" HorizontalAlignment="Center"
                    IsVisible="{Binding ShowQr}">
              <Image Source="{Binding QrImage}" Stretch="Uniform"/>
            </Border>
            <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock Classes="secondary" Text="{Binding AccountText}" HorizontalAlignment="Center"
                       TextWrapping="Wrap" IsVisible="{Binding IsLoggedIn}"/>
          </StackPanel>

          <!-- 操作 -->
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10"
                      HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button Classes="primary" Content="扫码登录" Command="{Binding StartLoginCommand}"
                    IsEnabled="{Binding !IsBusy}" IsVisible="{Binding !IsLoggedIn}"/>
            <Button Content="取消" Command="{Binding CancelCommand}"
                    IsVisible="{Binding IsBusy}"/>
            <Button Content="关闭" Click="OnCloseLoginPanelClick"
                    IsVisible="{Binding !IsBusy}"/>
            <Button Content="退出登录" Command="{Binding LogoutCommand}"
                    IsVisible="{Binding IsLoggedIn}"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
