<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pandre.Desktop.ViewModels"
             x:Class="Pandre.Desktop.Views.LoginView"
             x:DataType="vm:LoginViewModel">
  <ScrollViewer>
    <Grid ColumnDefinitions="*,20,*">
      <!-- 百度 -->
      <Border Grid.Column="0" Classes="card">
        <StackPanel Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon Data="M12 3a5 5 0 0 0-4.9 4.1A4.5 4.5 0 0 0 7.5 16h9a4 4 0 0 0 .6-7.96A5.5 5.5 0 0 0 12 3z"
                      Width="22" Height="22" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Classes="card-title" Text="{Binding Baidu.Title}" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Classes="secondary" Text="用百度网盘 App 或百度 App 扫码"/>
          <Border Width="216" Height="216" Background="White" CornerRadius="8" HorizontalAlignment="Left"
                  IsVisible="{Binding Baidu.ShowQr}">
            <Image Source="{Binding Baidu.QrImage}" Stretch="Uniform" Margin="8"/>
          </Border>
          <TextBlock Classes="secondary" Text="{Binding Baidu.StatusText}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Baidu.AccountText}" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="primary" Content="扫码登录" Command="{Binding Baidu.StartLoginCommand}" IsEnabled="{Binding !Baidu.IsBusy}"/>
            <Button Content="取消" Command="{Binding Baidu.CancelCommand}" IsVisible="{Binding Baidu.IsBusy}"/>
            <Button Content="退出登录" Command="{Binding Baidu.LogoutCommand}" IsVisible="{Binding Baidu.IsLoggedIn}"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <!-- 夸克 -->
      <Border Grid.Column="2" Classes="card">
        <StackPanel Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon Data="M12 3a5 5 0 0 0-4.9 4.1A4.5 4.5 0 0 0 7.5 16h9a4 4 0 0 0 .6-7.96A5.5 5.5 0 0 0 12 3z"
                      Width="22" Height="22" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Classes="card-title" Text="{Binding Quark.Title}" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Classes="secondary" Text="用夸克网盘 App 或夸克 App 扫码"/>
          <Border Width="216" Height="216" Background="White" CornerRadius="8" HorizontalAlignment="Left"
                  IsVisible="{Binding Quark.ShowQr}">
            <Image Source="{Binding Quark.QrImage}" Stretch="Uniform" Margin="8"/>
          </Border>
          <TextBlock Classes="secondary" Text="{Binding Quark.StatusText}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Quark.AccountText}" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="primary" Content="扫码登录" Command="{Binding Quark.StartLoginCommand}" IsEnabled="{Binding !Quark.IsBusy}"/>
            <Button Content="取消" Command="{Binding Quark.CancelCommand}" IsVisible="{Binding Quark.IsBusy}"/>
            <Button Content="退出登录" Command="{Binding Quark.LogoutCommand}" IsVisible="{Binding Quark.IsLoggedIn}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
