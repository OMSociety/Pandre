<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Pandre.Desktop"
             xmlns:vm="using:Pandre.Desktop.ViewModels"
             x:Class="Pandre.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer>
    <StackPanel Spacing="16" MaxWidth="720">

      <!-- 个性化分组 -->
      <Border Classes="card">
        <StackPanel Spacing="4">
          <TextBlock Classes="card-title" Text="个性化" Margin="0,0,0,8"/>

          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8">
            <PathIcon Grid.Column="0" Data="{x:Static local:AppIcons.DarkTheme}"
                      Width="20" Height="20" VerticalAlignment="Top" Margin="0,4,14,0"
                      Foreground="{StaticResource TextSecondaryBrush}"/>
            <StackPanel Grid.Column="1">
              <TextBlock Text="应用主题"/>
              <TextBlock Classes="secondary" Text="更改应用程序的外观"/>
            </StackPanel>
            <ComboBox Grid.Column="2" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}"
                      MinWidth="170" VerticalAlignment="Center">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ThemeOption">
                  <TextBlock Text="{Binding Label}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>

          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8">
            <PathIcon Grid.Column="0" Data="{x:Static local:AppIcons.DarkTheme}"
                      Width="20" Height="20" VerticalAlignment="Top" Margin="0,4,14,0"
                      Foreground="{StaticResource TextSecondaryBrush}"/>
            <StackPanel Grid.Column="1">
              <TextBlock Text="窗口背景透明材质"/>
              <TextBlock Classes="secondary" Text="设置窗口背景透明效果和透明材质"/>
            </StackPanel>
            <ComboBox Grid.Column="2" ItemsSource="{Binding MaterialOptions}" SelectedItem="{Binding SelectedMaterial}"
                      MinWidth="170" VerticalAlignment="Center">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MaterialOption">
                  <TextBlock Text="{Binding Label}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
        </StackPanel>
      </Border>

      <!-- 下载分组 -->
      <Border Classes="card">
        <StackPanel Spacing="4">
          <TextBlock Classes="card-title" Text="下载" Margin="0,0,0,8"/>
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8">
            <PathIcon Grid.Column="0" Data="{x:Static local:AppIcons.ArrowDownload}"
                      Width="20" Height="20" VerticalAlignment="Top" Margin="0,4,14,0"
                      Foreground="{StaticResource TextSecondaryBrush}"/>
            <StackPanel Grid.Column="1">
              <TextBlock Text="下载目录"/>
              <TextBlock Classes="secondary" Text="文件保存到本地的位置"/>
            </StackPanel>
            <Grid Grid.Column="2" ColumnDefinitions="Auto,Auto" VerticalAlignment="Center">
              <TextBox Grid.Column="0" Text="{Binding DownloadDir}" MinWidth="320"/>
              <Button Grid.Column="1" Content="浏览…" Click="OnBrowseDownloadDir" Margin="8,0,0,0"
                      ToolTip.Tip="选择下载目录"/>
            </Grid>
          </Grid>

          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8">
            <PathIcon Grid.Column="0" Data="{x:Static local:AppIcons.ArrowDownload}"
                      Width="20" Height="20" VerticalAlignment="Top" Margin="0,4,14,0"
                      Foreground="{StaticResource TextSecondaryBrush}"/>
            <StackPanel Grid.Column="1">
              <TextBlock Text="单任务连接数"/>
              <TextBlock Classes="secondary" Text="每个文件拆成几段同时下载（1-64），重启后生效"/>
            </StackPanel>
            <TextBox Grid.Column="2" Text="{Binding Aria2Connections}" MinWidth="80" VerticalAlignment="Center"/>
          </Grid>

          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8">
            <PathIcon Grid.Column="0" Data="{x:Static local:AppIcons.ArrowDownload}"
                      Width="20" Height="20" VerticalAlignment="Top" Margin="0,4,14,0"
                      Foreground="{StaticResource TextSecondaryBrush}"/>
            <StackPanel Grid.Column="1">
              <TextBlock Text="同时下载数"/>
              <TextBlock Classes="secondary" Text="队列里同时进行的任务个数（1-20），重启后生效"/>
            </StackPanel>
            <TextBox Grid.Column="2" Text="{Binding Aria2MaxConcurrent}" MinWidth="80" VerticalAlignment="Center"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- 关于分组 -->
      <Border Classes="card">
        <StackPanel Spacing="4">
          <TextBlock Classes="card-title" Text="关于" Margin="0,0,0,8"/>
          <TextBlock Classes="secondary" Text="盘多录 Pandre · GPL-3.0 · 聚合百度网盘与夸克网盘" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
