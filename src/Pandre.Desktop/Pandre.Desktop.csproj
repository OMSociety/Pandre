<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\pandre.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="assets\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\assets\windows\aria2c.exe" Link="assets\windows\aria2c.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\windows\aria2-COPYING.txt" Link="assets\windows\aria2-COPYING.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- 浏览器接管扩展源文件：构建时复制到输出目录 extension/，由 ExtensionInstaller 再装到 %APPDATA% -->
    <None Include="..\..\assets\extension\**" Link="extension\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pandre.Core\Pandre.Core.csproj" />
    <ProjectReference Include="..\Pandre.Download\Pandre.Download.csproj" />
  </ItemGroup>
</Project>
