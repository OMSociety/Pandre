<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Pandre.Desktop.App"
             xmlns:local="using:Pandre.Desktop"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
      <ResourceDictionary>
        <!-- 色板随主题变体整体切换：Brush 与 Color 同字典，切换即换 -->
        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Dark">
                <Color x:Key="AccentColor">#60CDFF</Color>
                <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF"/>
                <!-- 压在强调色实底上的前景色，运行时按系统强调色亮度改写 -->
                <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
                <!-- 分层卡片色（Fluent Layer on Mica，对齐 Win11 设置卡 #2B2B2B） -->
                <SolidColorBrush x:Key="CardBrush" Color="#0DFFFFFF"/>
                <SolidColorBrush x:Key="CardHoverBrush" Color="#14FFFFFF"/>
                <SolidColorBrush x:Key="CardBorderBrush" Color="#12FFFFFF"/>
                <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
                <SolidColorBrush x:Key="TextSecondaryBrush" Color="#D6D6D6"/>
                <SolidColorBrush x:Key="TextTertiaryBrush" Color="#B8B8B8"/>
                <SolidColorBrush x:Key="NavBgBrush" Color="#26000000"/>
                <SolidColorBrush x:Key="ThumbBgBrush" Color="#333333"/>
                <SolidColorBrush x:Key="NavHoverBrush" Color="#2E2E2E"/>
                <!-- 选中：强调色淡底 -->
                <SolidColorBrush x:Key="NavSelectedBrush" Color="#2A60CDFF"/>
                <!-- 伪弹窗：遮罩 + 抬升实体卡片 -->
                <SolidColorBrush x:Key="ScrimBrush" Color="#99000000"/>
                <SolidColorBrush x:Key="DialogBrush" Color="#F22B2B2B"/>
                <!-- Win11 控件观感：边框压淡、按钮低亮度（覆盖 Fluent 主题默认的 Win10 亮边框） -->
                <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#14FFFFFF"/>
                <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#26FFFFFF"/>
                <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#1AFFFFFF"/>
                <SolidColorBrush x:Key="TextControlBorderBrush" Color="#14FFFFFF"/>
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#26FFFFFF"/>
                <SolidColorBrush x:Key="ButtonBackground" Color="#0FFFFFFF"/>
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#15FFFFFF"/>
                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#08FFFFFF"/>
            </ResourceDictionary>
            <ResourceDictionary x:Key="Light">
                <Color x:Key="AccentColor">#0067C0</Color>
                <SolidColorBrush x:Key="AccentBrush" Color="#0067C0"/>
                <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
                <SolidColorBrush x:Key="CardBrush" Color="#FDFDFD"/>
                <SolidColorBrush x:Key="CardHoverBrush" Color="#F5F5F5"/>
                <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E5E5"/>
                <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1B1B"/>
                <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5A5A5A"/>
                <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6E6E6E"/>
                <SolidColorBrush x:Key="NavBgBrush" Color="#26FFFFFF"/>
                <SolidColorBrush x:Key="ThumbBgBrush" Color="#ECECEC"/>
                <SolidColorBrush x:Key="NavHoverBrush" Color="#E9E9E9"/>
                <SolidColorBrush x:Key="NavSelectedBrush" Color="#1F0067C0"/>
                <SolidColorBrush x:Key="ScrimBrush" Color="#59000000"/>
                <SolidColorBrush x:Key="DialogBrush" Color="#FFFFFFFF"/>
                <!-- Win11 控件观感（浅色）：边框压淡、按钮接近白卡 -->
                <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#29000000"/>
                <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#47000000"/>
                <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#38000000"/>
                <SolidColorBrush x:Key="TextControlBorderBrush" Color="#29000000"/>
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#47000000"/>
                <SolidColorBrush x:Key="ButtonBackground" Color="#0F000000"/>
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1A000000"/>
                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#29000000"/>
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <!-- Win11 控件圆角 4（Fluent 主题默认 3） -->
        <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
      </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- 窗口自绘按钮（装饰层 WindowDecorations=BorderOnly，标题带与主体同材质） -->
        <Style Selector="Button.caption">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
        </Style>
        <Style Selector="Button.caption:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavHoverBrush}"/>
        </Style>
        <Style Selector="Button.caption-close:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#C42B1C"/>
        </Style>
        <Style Selector="Button.caption-close:pointerover PathIcon">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.caption-close:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#B0241A"/>
        </Style>

        <!-- 基础文字 -->
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="TextBlock.tertiary">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.card-title">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- 卡片容器 -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- 伪弹窗卡片（浮在遮罩上，带投影） -->
        <Style Selector="Border.dialog">
            <Setter Property="Background" Value="{DynamicResource DialogBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BoxShadow" Value="0 16 44 0 #66000000"/>
        </Style>
        <Style Selector="Border.qr-frame">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <!-- 圆角按钮（按压下沉微交互） -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="RenderTransform" Value="translateY(0)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08"/>
                    <BrushTransition Property="Background" Duration="0:0:0.10"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="RenderTransform" Value="translateY(1px)"/>
        </Style>
        <!-- 图标按钮（小方块） -->
        <Style Selector="Button.icon-btn">
            <Setter Property="Padding" Value="7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MinWidth" Value="32"/>
        </Style>
        <!-- 主按钮 -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>

        <!-- 输入框 -->
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>

        <!-- 侧栏导航：裸模板，悬停/选中全交给我们自己的圆角 -->
        <Style Selector="ListBox.nav">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.nav ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="4,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Border.nav-item">
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:pointerover Border.nav-item">
            <Setter Property="Background" Value="{DynamicResource NavHoverBrush}"/>
        </Style>
        <!-- 当前页：强调色淡底 + 左侧强调色竖条（由 ListBoxItem:selected 驱动） -->
        <Style Selector="ListBox.nav ListBoxItem:selected Border.nav-item">
            <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
        </Style>
        <Style Selector="Border.sel-bar">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <!-- 侧栏文字 -->
        <Style Selector="Border.nav-item TextBlock">
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- 侧栏选中时图标与文字用强调色 -->
        <Style Selector="ListBox.nav ListBoxItem:selected Border.nav-item PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <!-- 选中态只换前景色，不加粗：SemiBold 在浅色主题下笔画互相挤压，且会撑动文字宽度 -->
        <Style Selector="ListBox.nav ListBoxItem:selected Border.nav-item TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <!-- 文件/下载行：裸模板——悬停/选中视觉全由 row-card 接管，圆角永远成立 -->
        <Style Selector="ListBox.rows">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.rows ListBoxItem">
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"/>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- 行卡片（悬停只换底色，不做位移与阴影：外扩部分会被列表裁切） -->
        <Style Selector="Border.row-card">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.row-card:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
        </Style>
        <!-- 选中行：左侧强调色竖条 + 描边 -->
        <Style Selector="ListBox.rows ListBoxItem:selected Border.sel-bar">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="ListBox.rows ListBoxItem:selected Border.row-card">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <!-- 进度条 -->
        <Style Selector="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="CornerRadius" Value="2"/>
        </Style>

        <!-- 滚动条调细 -->
        <Style Selector="ScrollBar">
            <Setter Property="Width" Value="10"/>
        </Style>
    </Application.Styles>
</Application>
